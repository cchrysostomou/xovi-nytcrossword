# Copy to config.env at the repository root for local use, or
# /home/root/xovi-nytcrossword/config.env on the tablet.
# Plain KEY=value lines only; readers parse this file and never execute it.
# Do not add quotes around values. Keep this example free of personal settings.

# Value of the NYT-S cookie from a logged-in nytimes.com browser session.
NYT_S_COOKIE=

# The following settings are only used by the optional desktop Python prototype.
# The AppLoad runtime does not require Python or rmapi.
NYT_COOKIE=
RMAPI_PATH=rmapi
RMAPI_FOLDER=/Crosswords

# AppLoad destination and XOVI broker settings.
CROSSWORD_FOLDER=/Crosswords
MB_IN_PATH=/run/xovi-mb
MB_OUT_PATH=/run/xovi-mb-out
BROKER_TIMEOUT_S=30

# Show the NYT Quick Settings button when today's crossword is missing (3.28).
INCLUDE_QUICK_DOWNLOAD=true
