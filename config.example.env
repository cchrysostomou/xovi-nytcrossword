# Copy to config.env at the repository root for local use, or
# /home/root/xovi-nytcrossword/config.env on the tablet.
# Plain KEY=value lines only; readers parse this file and never execute it.
# Do not add quotes around values. Keep this example free of personal settings.

# Value of the NYT-S cookie from a logged-in nytimes.com browser session.
NYT_S_COOKIE=

# Optional full Cookie header for the standalone Python downloader.
# If empty, it uses NYT_S_COOKIE above. Never pass credentials on the command line.
NYT_COOKIE=

# Optional standalone downloader upload settings.
RMAPI_PATH=rmapi
RMAPI_FOLDER=/Crosswords
